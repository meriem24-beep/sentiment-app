
# Configuration du client web
API_URL=http://127.0.0.1:8000

# Ancienne clé (compatibilite)
API_KEY=changez-moi

# Nouvelles cles API : format cle:role,cle:role
# Remplacer les valeurs par de vraies cles locales dans .env
API_KEYS=changez-cette-cle-client-16-caracteres:client,changez-cette-cle-admin-16-caracteres:admin

# Origines autorisees pour le client web
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
